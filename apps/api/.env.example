# Copia este archivo a .env para desarrollo local. En producción define estas variables en el entorno del servicio
# (nunca subas un .env con secretos al repositorio).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---------- Base de datos (PostgreSQL 14+) ----------
# Desarrollo: `npm run db:dev -w @xiro/api` levanta un PostgreSQL local con estas credenciales (o usa docker-compose.yml).
# Producción (obligatoria): postgres://usuario:clave@host:5432/base   (si la clave lleva símbolos, codifícala como URL)
DATABASE_URL=postgres://xiro:xiro@localhost:54320/xiro
# Conexión DIRECTA a PostgreSQL (sin pooler). Solo hace falta si DATABASE_URL apunta a PgBouncer/pooler del proveedor:
# la agenda en tiempo real (LISTEN), la cola pg-boss y las migraciones necesitan una sesión fija. Vacía = DATABASE_URL.
# DATABASE_DIRECT_URL=postgres://usuario:clave@host-directo:5432/base
# TLS hacia la base: disable | require (verifica el certificado) | no-verify (cifra sin verificar la CA; solo si no queda otra).
# Por defecto: "require" en producción y "disable" en desarrollo.
DATABASE_SSL=disable

# Pool de conexiones. Regla práctica: (instancias de la API × DB_POOL_MAX) debe quedar por debajo de max_connections del servidor.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Corta consultas colgadas (también aplica statement_timeout / idle_in_transaction_session_timeout en el servidor).
DB_STATEMENT_TIMEOUT_MS=15000
# Recicla conexiones viejas (0 = desactivado); útil tras failovers o detrás de PgBouncer.
DB_MAX_LIFETIME_SECONDS=1800
# startup = envía statement_timeout e idle_in_transaction_session_timeout al conectar (conexión directa a PostgreSQL).
# none    = no los envía: OBLIGATORIO detrás de PgBouncer (modo transacción) o del pooler del proveedor, que rechazan
#           esos parámetros. Configúralos entonces en el rol (ver docs/database-pooling.md).
DB_SESSION_PARAMS=startup
# Tope del cierre ordenado al recibir SIGTERM (ms); pasado este tiempo el proceso sale aunque algo siga colgado.
SHUTDOWN_TIMEOUT_MS=25000
# Redis compartido: límites de abuso entre instancias y caché de las páginas públicas. OBLIGATORIO en producción
# (rediss:// = con TLS). En desarrollo, vacío = memoria del proceso.
# REDIS_URL=rediss://default:clave@host:6379
# Rutas /api/admin (confirmar transferencias manuales). Mínimo 32 caracteres aleatorios: openssl rand -base64 48
# Va SOLO en la cabecera X-Admin-Secret (nunca en la URL). Sin definir = las rutas admin responden 503.
# ADMIN_SECRET=

# Panel del fundador / administración de la plataforma (/platform en la web, /api/platform en la API). Ver docs/platform-admin.md.
# Sin PLATFORM_ADMIN_KEY el panel NO existe (404). Es la clave que cifra los secretos TOTP de los administradores: guárdala
# como secreto y no la cambies (cambiarla obliga a reinscribir el MFA de todos con `npm run platform:admin -- reset-mfa`).
# Mínimo 32 caracteres: openssl rand -base64 48
# PLATFORM_ADMIN_KEY=
# Opcional: IPs permitidas para /api/platform (el resto recibe 404), separadas por coma.
# PLATFORM_ADMIN_ALLOWED_IPS=
# Sesión de administrador: vida máxima (h), cierre por inactividad (min) y vigencia de la reautenticación TOTP para acciones sensibles (min).
# PLATFORM_SESSION_HOURS=8
# PLATFORM_IDLE_MINUTES=30
# PLATFORM_STEP_UP_MINUTES=5

# Proveedor de mensajes (códigos de verificación y recordatorios). "console" solo los escribe en el log y la API se
# NIEGA a arrancar con él en producción. Los proveedores reales se agregarán cuando haya cuentas (Resend, WhatsApp…).
NOTIFIER_PROVIDER=console

# Imágenes. local = carpeta DATA_DIR/media (solo desarrollo). s3 = almacén compatible con S3; OBLIGATORIO en producción.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, y un token de API de R2
# con permiso de lectura/escritura SOLO sobre ese bucket. Migrar las imágenes existentes: npm run media:migrate -w @xiro/api
MEDIA_STORAGE=local
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Subidas de imágenes por negocio en 24 h.
MEDIA_UPLOADS_PER_DAY=300
# Caché de las lecturas públicas (página de reservas y catálogo compartido), en segundos; 0 la apaga. Usa Redis si
# REDIS_URL está configurada (compartida entre instancias); si no, memoria del proceso. Se invalida sola en cuanto el
# negocio guarda cualquier cambio. "Abierto ahora" del perfil se guarda como máximo 15 s.
PUBLIC_CACHE_TTL_SECONDS=300
# Opcional: IPs permitidas para /api/admin, separadas por coma (p. ej. la IP fija de la oficina).
# ADMIN_ALLOWED_IPS=
# Contraseñas (argon2id): hashes simultáneos y cuántos pueden esperar antes de responder 503 "server_busy".
# Cada hash usa ~19 MiB y ~30 ms; subir HASH_CONCURRENCY consume más RAM y hilos de libuv.
HASH_CONCURRENCY=2
HASH_QUEUE_MAX=200
# Descargas PDF/Excel (Balance, Gastos): hilos de trabajo que las generan sin bloquear la API, cuántas pueden esperar antes de
# responder 503 "server_busy" y el tiempo máximo por archivo. Cada hilo ocupa ~60–120 MB de RAM mientras genera. 0 = sin hilos.
EXPORT_WORKERS=2
EXPORT_QUEUE_MAX=20
EXPORT_TIMEOUT_MS=60000
# Tope de memoria (heap) de CADA hilo de descarga, en MB. Presupuesto del contenedor: heap de la API + EXPORT_WORKERS × este valor.
EXPORT_WORKER_MEMORY_MB=256
# Aplica las migraciones pendientes al arrancar. Por defecto: true en desarrollo, false en producción
# (en producción ejecuta `npm run db:migrate -w @xiro/api` como paso del despliegue).
AUTO_MIGRATE=true

# ---------- Observabilidad y estabilidad (Fase 4, ver docs/deploy.md) ----------
# Sentry (opcional): sin DSN no se carga el SDK. Solo errores, sin datos personales (cuerpos, cookies, IP).
# SENTRY_DSN=https://<clave>@o<org>.ingest.sentry.io/<proyecto>
# SENTRY_ENVIRONMENT=production
# Versión desplegada (p. ej. el commit): agrupa los errores por despliegue.
# RELEASE=
# Métricas Prometheus en GET /api/metrics con "Authorization: Bearer <token>". Sin token, la ruta no existe (404).
# Mínimo 32 caracteres: openssl rand -base64 32
# METRICS_TOKEN=
# Compresión gzip de respuestas JSON grandes. Apágala si un proxy/CDN delante ya comprime.
COMPRESSION=on
# Bajo sobrecarga: 503 + Retry-After en vez de lentitud para todos. Demora del event loop (ms) y heap (MB, 0 = sin tope:
# en contenedores pon ~80 % de NODE_OPTIONS=--max-old-space-size).
MAX_EVENT_LOOP_DELAY_MS=1000
MAX_HEAP_USED_MB=0
# Debe ser MAYOR que el keep-alive del balanceador (60 s en la mayoría) para evitar 502 intermitentes.
KEEP_ALIVE_TIMEOUT_MS=72000

# ---------- Sesiones (JWT) ----------
# Obligatorio en producción: mínimo 32 caracteres aleatorios. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=xiro-style-api
JWT_AUDIENCE=xiro-style-app
# Vida del access token (los refresh tokens rotan y duran 30 días). Formato: 30s, 15m, 1h.
JWT_ACCESS_TTL=15m

# ---------- CORS y cabeceras de seguridad ----------
# Orígenes exactos permitidos (esquema + host + puerto, separados por coma). Sin "*". En producción deben ser https.
# Vacío = solo mismo origen (lo normal si la API sirve la app web).
CORS_ORIGINS=http://localhost:8081
# Content-Security-Policy (on/off) y orígenes extra que la app web puede contactar / de los que puede cargar imágenes.
SECURITY_CSP=on
CSP_CONNECT_SRC=
CSP_IMG_SRC=
# HSTS: por defecto "on" en producción y "off" en desarrollo.
# SECURITY_HSTS=on

# ---------- Límite de peticiones ----------
# on (por defecto) | off. "off" está prohibido en producción.
RATE_LIMIT=on
# Por IP, todas las rutas de la API (peticiones/minuto).
RATE_LIMIT_GLOBAL_PER_MIN=300
# Por usuario autenticado, aunque cambie de IP.
RATE_LIMIT_USER_PER_MIN=600
# Por IP en registro/login/refresh/recuperación (más estricto).
RATE_LIMIT_AUTH_PER_MIN=10
# Fuerza bruta por cuenta: intentos fallidos permitidos dentro de la ventana, sin importar la IP de origen.
RATE_LIMIT_ACCOUNT_ATTEMPTS=10
RATE_LIMIT_ACCOUNT_WINDOW_MIN=15
# Detrás de un proxy inverso / balanceador: número de saltos confiables (p. ej. 1) para que los límites vean la IP real.
# "true" confía en cualquier X-Forwarded-For (falsificable): evítalo. Sin proxy déjalo en false.
TRUST_PROXY=false

# ---------- Archivos ----------
# Carpeta con las fotos subidas. En varias instancias debe ser un volumen compartido (o migrar a almacenamiento de objetos).
DATA_DIR=./data
# Carpeta con la app web exportada (npm run build:web). Se sirve en "/".
WEB_DIR=../mobile/dist

# SOLO desarrollo: devuelve el código OTP en la respuesta de /recover/request.
# Nunca en producción (la API se niega a arrancar). Sin proveedor SMS/WhatsApp/correo el código se imprime en consola.
EXPOSE_DEV_OTP=true

# ---------- Citas y página pública de reservas (/reservar/<negocio>) ----------
# Peticiones por minuto a la página pública de UN negocio (todas las IP juntas): frena el abuso dirigido a un solo negocio.
BOOKING_PUBLIC_PER_MIN_BUSINESS=240
# PENDIENTE DE CREDENCIALES — Cloudflare Turnstile (anti-bots del formulario de reserva).
# Sin secreto la verificación queda apagada (siguen activos el campo trampa, los límites por IP y por negocio y el tope de
# reservas pendientes por celular). Con secreto, toda reserva pública exige un token válido.
TURNSTILE_SECRET=
# Clave PÚBLICA de Turnstile (no es secreta: viaja al navegador). Sin ella la página de reservas no dibuja el widget.
TURNSTILE_SITE_KEY=
# PENDIENTE DE CREDENCIALES — Google Maps Platform (ubicación del local en "Mi página web"). Guía: docs/GOOGLE_MAPS.md.
# Clave SOLO del servidor (Places API New, Geocoding API, Maps Static API). No viaja al navegador; restríngela por IP del servidor.
# Sin ella el selector de ubicación avisa que no está configurado y la página pública muestra dirección y botones, sin mapa.
GOOGLE_MAPS_SERVER_KEY=
# Clave del navegador (Maps JavaScript API) para el mapa con pin arrastrable de la app web. SÍ viaja al navegador de quien
# gestiona la página: restríngela por dominio (HTTP referrer) y solo a Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Carpeta con la página pública de reservas exportada (npm run build:public). Se sirve en "/reservar".
PUBLIC_WEB_DIR=../public/dist

# Requisitos de la base de datos para las citas (la migración 0006 los crea; no se configuran aquí):
#  - extensión btree_gist (impide por sí sola el doble agendamiento de un profesional). En PostgreSQL gestionado, actívala si el
#    proveedor la exige (Supabase/Neon/RDS/Cloud SQL la incluyen).
#  - rol sin privilegios `xiro_app` (Row Level Security de las tablas de citas). El usuario de la API debe poder hacer SET ROLE a él;
#    la migración le concede esa pertenencia si no es superusuario.
# PENDIENTE DE CREDENCIALES (aún sin implementar; se añadirán con sus adaptadores en fases posteriores):
#  RESEND_API_KEY (correos), WHATSAPP_* (canal de mensajes), EAS (compilaciones móviles). Ya disponibles: S3_* (R2) y SENTRY_DSN.
