# Copia este archivo a .env para desarrollo local. En producción define estas variables en el entorno del servicio
# (nunca subas un .env con secretos al repositorio).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---------- Base de datos (PostgreSQL 14+) ----------
# Desarrollo: `npm run db:dev -w @xiro/api` levanta un PostgreSQL local con estas credenciales (o usa docker-compose.yml).
# Producción (obligatoria): postgres://usuario:clave@host:5432/base   (si la clave lleva símbolos, codifícala como URL)
DATABASE_URL=postgres://xiro:xiro@localhost:54320/xiro
# TLS hacia la base: disable | require (verifica el certificado) | no-verify (cifra sin verificar la CA; solo si no queda otra).
# Por defecto: "require" en producción y "disable" en desarrollo.
DATABASE_SSL=disable

# Pool de conexiones. Regla práctica: (instancias de la API × DB_POOL_MAX) debe quedar por debajo de max_connections del servidor.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Corta consultas colgadas (también aplica statement_timeout / idle_in_transaction_session_timeout en el servidor).
DB_STATEMENT_TIMEOUT_MS=15000
# Recicla conexiones viejas (0 = desactivado); útil tras failovers o detrás de PgBouncer.
DB_MAX_LIFETIME_SECONDS=1800
# Aplica las migraciones pendientes al arrancar. Por defecto: true en desarrollo, false en producción
# (en producción ejecuta `npm run db:migrate -w @xiro/api` como paso del despliegue).
AUTO_MIGRATE=true

# ---------- Sesiones (JWT) ----------
# Obligatorio en producción: mínimo 32 caracteres aleatorios. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=xiro-style-api
JWT_AUDIENCE=xiro-style-app
# Vida del access token (los refresh tokens rotan y duran 30 días). Formato: 30s, 15m, 1h.
JWT_ACCESS_TTL=15m

# ---------- CORS y cabeceras de seguridad ----------
# Orígenes exactos permitidos (esquema + host + puerto, separados por coma). Sin "*". En producción deben ser https.
# Vacío = solo mismo origen (lo normal si la API sirve la app web).
CORS_ORIGINS=http://localhost:8081
# Content-Security-Policy (on/off) y orígenes extra que la app web puede contactar / de los que puede cargar imágenes.
SECURITY_CSP=on
CSP_CONNECT_SRC=
CSP_IMG_SRC=
# HSTS: por defecto "on" en producción y "off" en desarrollo.
# SECURITY_HSTS=on

# ---------- Límite de peticiones ----------
# on (por defecto) | off. "off" está prohibido en producción.
RATE_LIMIT=on
# Por IP, todas las rutas de la API (peticiones/minuto).
RATE_LIMIT_GLOBAL_PER_MIN=300
# Por usuario autenticado, aunque cambie de IP.
RATE_LIMIT_USER_PER_MIN=600
# Por IP en registro/login/refresh/recuperación (más estricto).
RATE_LIMIT_AUTH_PER_MIN=10
# Fuerza bruta por cuenta: intentos fallidos permitidos dentro de la ventana, sin importar la IP de origen.
RATE_LIMIT_ACCOUNT_ATTEMPTS=10
RATE_LIMIT_ACCOUNT_WINDOW_MIN=15
# Detrás de un proxy inverso / balanceador: número de saltos confiables (p. ej. 1) para que los límites vean la IP real.
# "true" confía en cualquier X-Forwarded-For (falsificable): evítalo. Sin proxy déjalo en false.
TRUST_PROXY=false

# ---------- Archivos ----------
# Carpeta con las fotos subidas. En varias instancias debe ser un volumen compartido (o migrar a almacenamiento de objetos).
DATA_DIR=./data
# Carpeta con la app web exportada (npm run build:web). Se sirve en "/".
WEB_DIR=../mobile/dist

# SOLO desarrollo: devuelve el código OTP en la respuesta de /recover/request.
# Nunca en producción (la API se niega a arrancar). Sin proveedor SMS/WhatsApp/correo el código se imprime en consola.
EXPOSE_DEV_OTP=true

# ---------- Citas y página pública de reservas (/reservar/<negocio>) ----------
# Peticiones por minuto a la página pública de UN negocio (todas las IP juntas): frena el abuso dirigido a un solo negocio.
BOOKING_PUBLIC_PER_MIN_BUSINESS=240
# PENDIENTE DE CREDENCIALES — Cloudflare Turnstile (anti-bots del formulario de reserva).
# Sin secreto la verificación queda apagada (siguen activos el campo trampa, los límites por IP y por negocio y el tope de
# reservas pendientes por celular). Con secreto, toda reserva pública exige un token válido.
TURNSTILE_SECRET=
# Clave PÚBLICA de Turnstile (no es secreta: viaja al navegador). Sin ella la página de reservas no dibuja el widget.
TURNSTILE_SITE_KEY=
# PENDIENTE DE CREDENCIALES — Google Maps Platform (ubicación del local en "Mi página web"). Guía: docs/GOOGLE_MAPS.md.
# Clave SOLO del servidor (Places API New, Geocoding API, Maps Static API). No viaja al navegador; restríngela por IP del servidor.
# Sin ella el selector de ubicación avisa que no está configurado y la página pública muestra dirección y botones, sin mapa.
GOOGLE_MAPS_SERVER_KEY=
# Clave del navegador (Maps JavaScript API) para el mapa con pin arrastrable de la app web. SÍ viaja al navegador de quien
# gestiona la página: restríngela por dominio (HTTP referrer) y solo a Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Carpeta con la página pública de reservas exportada (npm run build:public). Se sirve en "/reservar".
PUBLIC_WEB_DIR=../public/dist

# Requisitos de la base de datos para las citas (la migración 0006 los crea; no se configuran aquí):
#  - extensión btree_gist (impide por sí sola el doble agendamiento de un profesional). En PostgreSQL gestionado, actívala si el
#    proveedor la exige (Supabase/Neon/RDS/Cloud SQL la incluyen).
#  - rol sin privilegios `xiro_app` (Row Level Security de las tablas de citas). El usuario de la API debe poder hacer SET ROLE a él;
#    la migración le concede esa pertenencia si no es superusuario.
# PENDIENTE DE CREDENCIALES (aún sin implementar; se añadirán con sus adaptadores en fases posteriores):
#  RESEND_API_KEY (correos), R2_* (almacenamiento de imágenes), SENTRY_DSN (errores), WHATSAPP_* (canal de mensajes), EAS (compilaciones móviles).
