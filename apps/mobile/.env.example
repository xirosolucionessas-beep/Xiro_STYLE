# Se inyectan en el bundle al compilar (prefijo EXPO_PUBLIC_): nunca pongas secretos aquí.

# URL de la API. Si se omite: en desarrollo se usa la IP de tu PC en el puerto 3000; en web servida por la API, el mismo origen.
# OBLIGATORIA en compilaciones de producción (EAS) y debe ser https://… : sin ella, o con http://, la app no se conecta
# (nunca envía sesiones ni datos de clientes sin cifrar).
EXPO_PUBLIC_API_URL=

# Base de los enlaces de catálogo que se comparten con clientes (por defecto, la URL de la API).
EXPO_PUBLIC_PUBLIC_URL=

# Número (con código de país, solo dígitos) para "Soporte por WhatsApp". Si se omite, la opción se oculta.
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Claves PÚBLICAS de RevenueCat (panel > Project settings > API keys — no son secretas, están hechas para ir en el
# cliente, como la "publishable key" de Stripe). Sin esto el paywall de iOS/Android no puede cargar ofertas.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
