{
  "expo": {
    "name": "Xiro Style",
    "slug": "xiro-style",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xirostyle",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0d0f",
    "ios": {
      "bundleIdentifier": "com.xirostyle.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Xiro Style usa la cámara para fotografiar tus productos y servicios.",
        "NSPhotoLibraryUsageDescription": "Xiro Style accede a tus fotos para el logo, el catálogo y las fotos de tu equipo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xirostyle.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xiro Style usa tu ubicación solo cuando pulsas «Usar mi ubicación actual» para marcar tu local en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Xiro Style accede a tus fotos para el logo y el catálogo.",
          "cameraPermission": "Xiro Style usa la cámara para fotografiar tus productos y servicios.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bad711d0-b6a1-47f0-8859-1b4a81920757"
      }
    }
  }
}
