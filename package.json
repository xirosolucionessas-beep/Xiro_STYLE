{
  "name": "xiro-style",
  "private": true,
  "version": "2.0.0",
  "description": "Xiro Style: gestión de negocio de belleza (Android, iOS y Web) con API y catálogo público",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "npm run dev -w @xiro/api",
    "dev:mobile": "npm run start -w @xiro/mobile",
    "dev:web": "npm run web -w @xiro/mobile",
    "dev:public": "npm run dev -w @xiro/public",
    "build:web": "npm run export:web -w @xiro/mobile",
    "build:public": "npm run build -w @xiro/public",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "typescript": "~6.0.3"
  }
}
